{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-test",
    "rootDir": ".",
    "tsBuildInfoFile": "./dist-test/.tsbuildinfo",
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
