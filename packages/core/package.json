{
  "name": "@crewspace/core",
  "version": "0.1.0",
  "description": "Core agent orchestration framework for Crewspace — define and run multi-agent workflows in pure TypeScript",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/cjs/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/build-cjs.js",
    "clean": "tsc --build --clean && rimraf dist",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node --input-type=commonjs -e \"require('fs').writeFileSync('benchmark-results-detailed.jsonl','')\" && vitest run --config vitest.bench.config.ts",
    "bench:ci": "node --input-type=commonjs -e \"require('fs').writeFileSync('benchmark-results-detailed.jsonl','')\" && vitest run --config vitest.bench.config.ts --reporter=json --outputFile=benchmark-results.json",
    "bench:compare": "tsx scripts/compare-benchmarks.ts",
    "bench:report": "tsx scripts/generate-perf-report.ts",
    "bench:ci-summary": "tsx scripts/format-ci-summary.ts",
    "bench:update-baseline": "tsx scripts/update-baseline.ts",
    "bundle:analyze": "tsx scripts/bundle-size-analysis.ts",
    "bundle:update-baseline": "tsx scripts/bundle-size-analysis.ts --update-baseline",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.8.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "agent",
    "orchestration",
    "multi-agent",
    "typescript",
    "ai",
    "llm",
    "framework",
    "crewspace",
    "workflow",
    "event-driven"
  ],
  "homepage": "https://github.com/aviferdman/ProjectX2-Product#readme",
  "bugs": {
    "url": "https://github.com/aviferdman/ProjectX2-Product/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aviferdman/ProjectX2-Product.git",
    "directory": "packages/core"
  }
}
