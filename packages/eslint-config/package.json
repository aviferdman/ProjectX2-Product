{
  "name": "@crewspace/eslint-config",
  "version": "0.1.0",
  "description": "Shareable ESLint flat config for Crewspace projects — TypeScript best practices for agent orchestration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "crewspace",
    "eslint",
    "eslint-config",
    "typescript",
    "agent",
    "orchestration",
    "best-practices",
    "flat-config"
  ],
  "homepage": "https://github.com/aviferdman/ProjectX2-Product#readme",
  "bugs": {
    "url": "https://github.com/aviferdman/ProjectX2-Product/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aviferdman/ProjectX2-Product.git",
    "directory": "packages/eslint-config"
  }
}
