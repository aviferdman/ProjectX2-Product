{
  "name": "@crewspace/tools-file",
  "version": "0.1.0",
  "description": "File tools for Crewspace agents — read, write, and list files with sandbox safety",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/build-cjs.js",
    "clean": "tsc --build --clean && rimraf dist",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@crewspace/core": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1"
  },
  "keywords": [
    "crewspace",
    "tools",
    "file",
    "agent",
    "orchestration",
    "typescript",
    "ai",
    "llm",
    "read-file",
    "write-file"
  ],
  "author": "Crewspace Contributors",
  "homepage": "https://github.com/aviferdman/ProjectX2-Product#readme",
  "bugs": {
    "url": "https://github.com/aviferdman/ProjectX2-Product/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aviferdman/ProjectX2-Product.git",
    "directory": "packages/tools-file"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
