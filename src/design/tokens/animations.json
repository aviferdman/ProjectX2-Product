{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "crewspace": {
    "animations": {
      "_description": "TASK-173: Animation system — page transitions, state changes, and loading animations. Extends visual-polish animation tokens with concrete animation presets.",

      "duration": {
        "_description": "Named duration presets from the visual polish system.",
        "instant": { "value": "50ms", "type": "duration" },
        "fast": { "value": "100ms", "type": "duration" },
        "normal": { "value": "150ms", "type": "duration" },
        "moderate": { "value": "200ms", "type": "duration" },
        "slow": { "value": "300ms", "type": "duration" },
        "enter": { "value": "250ms", "type": "duration" },
        "exit": { "value": "200ms", "type": "duration" },
        "page": { "value": "350ms", "type": "duration", "description": "Page-level transitions" }
      },

      "easing": {
        "_description": "Named easing curves for different animation types.",
        "default": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" },
        "in": { "value": "cubic-bezier(0.4, 0, 1, 1)", "type": "cubicBezier", "description": "Accelerate (exit)" },
        "out": { "value": "cubic-bezier(0, 0, 0.2, 1)", "type": "cubicBezier", "description": "Decelerate (enter)" },
        "in-out": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" },
        "spring": { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "type": "cubicBezier", "description": "Spring bounce" },
        "bounce": { "value": "cubic-bezier(0.68, -0.55, 0.265, 1.55)", "type": "cubicBezier", "description": "Playful bounce" }
      },

      "pageTransition": {
        "_description": "Presets for page-level transitions (route changes, view switches).",
        "fade": {
          "duration": { "value": "300ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" }
        },
        "slideUp": {
          "duration": { "value": "350ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0, 0, 0.2, 1)", "type": "cubicBezier" },
          "distance": { "value": "16px", "type": "sizing" }
        },
        "slideLeft": {
          "duration": { "value": "300ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0, 0, 0.2, 1)", "type": "cubicBezier" },
          "distance": { "value": "24px", "type": "sizing" }
        }
      },

      "stateChange": {
        "_description": "Presets for state transitions (hover, active, toggle, collapse).",
        "hover": {
          "duration": { "value": "150ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" }
        },
        "toggle": {
          "duration": { "value": "200ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" }
        },
        "collapse": {
          "duration": { "value": "250ms", "type": "duration" },
          "easing": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" }
        }
      },

      "loading": {
        "_description": "Presets for loading indicators and skeleton screens.",
        "skeleton": {
          "duration": { "value": "1.5s", "type": "duration" },
          "easing": { "value": "ease-in-out", "type": "cubicBezier" }
        },
        "shimmer": {
          "duration": { "value": "2s", "type": "duration" },
          "easing": { "value": "linear", "type": "cubicBezier" }
        },
        "pulse": {
          "duration": { "value": "1.5s", "type": "duration" },
          "easing": { "value": "ease-in-out", "type": "cubicBezier" }
        },
        "spin": {
          "duration": { "value": "750ms", "type": "duration" },
          "easing": { "value": "linear", "type": "cubicBezier" }
        }
      },

      "stagger": {
        "delay": { "value": "40ms", "type": "duration" },
        "maxDelay": { "value": "500ms", "type": "duration" },
        "maxItems": { "value": "12", "type": "number", "description": "Items beyond this threshold appear instantly" }
      }
    }
  }
}
