      "toolbar": {
        "height": { "value": "48px", "type": "sizing" },
        "btn-size": { "value": "36px", "type": "sizing" },
        "icon-size": { "value": "18px", "type": "sizing" },
        "gap": { "value": "4px", "type": "spacing" },
        "padding": { "value": "0 12px", "type": "spacing" },
        "divider-gap": {
          "value": "8px",
          "type": "spacing",
          "description": "Margin on each side of vertical dividers"
        }
      },
      "sidebar": {
        "width": { "value": "280px", "type": "sizing" },
        "collapsed-width": { "value": "48px", "type": "sizing" },
        "padding": { "value": "12px", "type": "spacing" },
        "section-gap": { "value": "16px", "type": "spacing" }
      },
      "properties": {
        "width": { "value": "320px", "type": "sizing" },
        "padding": { "value": "16px", "type": "spacing" },
        "label-width": { "value": "100px", "type": "sizing" },
        "input-height": { "value": "32px", "type": "sizing" },
        "header-height": { "value": "48px", "type": "sizing" }
      },
      "animation": {
        "node-enter": {
          "value": "200ms cubic-bezier(0.34,1.56,0.64,1)",
          "type": "transition",
          "description": "Scale-in bounce when a node is added"
        },
        "edge-draw": {
          "value": "300ms ease-out",
          "type": "transition",
          "description": "Edge path animation on connect"
        },
        "running-pulse": {
          "value": "1.5s ease-in-out infinite",
          "type": "transition",
          "description": "Glow pulse when node is executing"
        },
        "data-flow": {
          "value": "1s linear infinite",
          "type": "transition",
          "description": "Animated dash on active edge"
        }
