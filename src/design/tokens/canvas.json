        "border-radius": { "value": "8px", "type": "borderRadius" },
        "opacity": { "value": "0.85", "type": "number" },
        "bg": { "value": "rgba(17,17,19,0.9)", "type": "color" },
        "viewport-color": { "value": "rgba(99,102,241,0.3)", "type": "color" }
