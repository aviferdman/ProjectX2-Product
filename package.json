{
  "name": "crewspace",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript-native agent orchestration framework with visual canvas",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\"",
    "clean": "npm run clean --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "version:check": "tsx scripts/check-versions.ts",
    "publish:prepare": "tsx scripts/prepare-publish.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "tsx": "^4.19.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2"
  }
}
